{
  "id": "servicos",
  "name": "Central de Serviços",
  "version": "3.2.0",
  "mode": "fragment",
  "routes": [
    "/servicos/*"
  ],
  "notify_roles": [
    "Administrador"
  ],
  "resources": {
    "cpu": 1.0,
    "memory": "1Gi",
    "pids": 100
  },
  "env": [
    "API_BASE_URL"
  ],
  "permissions": [
    "servicos.read"
  ],
  "sdk": "1.0",
  "runtime": {
    "stack": "python"
  },
  "stack": {
    "language": "Python 3.12",
    "framework": "FastAPI",
    "sdk": "hub-sdk-python 1.0",
    "db": "PostgreSQL 16",
    "libs": [
      "asyncpg"
    ]
  }
}

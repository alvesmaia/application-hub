                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "max_lines": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }

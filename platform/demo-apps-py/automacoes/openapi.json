  "info": {
    "title": "Automações — API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/automacoes/api/v1/execucoes": {
      "get": {
        "operationId": "list_runs",
        "parameters": [
          {
            "description": "Id do processo (0 = todos)",
            "in": "query",
            "name": "processo",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Id do processo (0 = todos)",
              "minimum": 0,
              "title": "Processo",
              "type": "integer"
            }
          },
          {
            "description": "Status da execução",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "default": "",
              "description": "Status da execução",
              "title": "Status",
              "type": "string"
            }
          },
          {
            "description": "Até 100",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "description": "Até 100",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Execuções, mais recentes primeiro (não administradores: só as suas)",
        "tags": [
          "Execuções"
        ],
        "x-hub-destructive": false
      }
    },
    "/automacoes/api/v1/execucoes/{id}": {
      "get": {
        "operationId": "get_run",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Uma execução",
        "tags": [
          "Execuções"
        ],
        "x-hub-destructive": false
      }
    },
    "/automacoes/api/v1/pacotes": {
      "get": {

              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Options",
            "type": "array"
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pattern"
          },
          "required": {
            "default": false,
            "title": "Required",
            "type": "boolean"
          },
          "type": {
            "enum": [
              "text",
              "number",
              "select",
              "checkbox",
              "textarea",
              "date"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "label",
          "type"

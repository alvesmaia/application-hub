          "Pacotes"
        ],
        "x-hub-destructive": false
      },
      "post": {
        "operationId": "upload_package",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_package"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Envia um pacote (multipart, campo arquivo)",
        "tags": [
          "Pacotes"
        ],
        "x-hub-destructive": false
      }
    },
    "/automacoes/api/v1/pacotes/base64": {
      "post": {
        "operationId": "upload_package_base64",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageBase64In"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Envia um pacote em base64 (para clientes MCP)",
        "tags": [
          "Pacotes"
        ],
        "x-hub-destructive": false
      }
    },
    "/automacoes/api/v1/processos": {

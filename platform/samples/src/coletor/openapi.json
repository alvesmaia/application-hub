              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Um pedido com as linhas (esperado × recebido)",
        "tags": [
          "Recebimento"
        ],
        "x-hub-destructive": false
      }
    },
    "/coletor/api/v1/reads": {
      "get": {
        "operationId": "reads_list",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadList"
                }
              }

              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Pedidos de recebimento",
        "tags": [
          "Recebimento"
        ],
        "x-hub-destructive": false
      }
    },
    "/coletor/api/v1/orders/{code}": {
      "get": {
        "operationId": "orders_get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {

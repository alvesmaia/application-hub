      "get": {
        "operationId": "approvals_pending",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Pedidos de aprovação pendentes (decisão pela Inbox do hub)",
        "tags": [
          "Aprovações"
        ],
        "x-hub-destructive": false
      }
    },

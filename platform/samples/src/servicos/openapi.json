              "title": "Agrupar",
              "type": "string"
            }
          },
          {
            "description": "Categoria",
            "in": "query",
            "name": "categoria",
            "required": false,
            "schema": {
              "description": "Categoria",
              "enum": [
                "Tecnologia",
                "Software",
                "Acessos",
                "Financeiro",
                "Facilities",
                "Pessoas",
                "Compras",
                "Infraestrutura"
              ],
              "title": "Categoria",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Erro (RFC 9457)"
          }
        },
        "summary": "Relatório agregado por período e categoria",
        "tags": [
          "Relatórios"
        ],
        "x-hub-destructive": false
      }

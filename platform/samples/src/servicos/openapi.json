{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "StatusIn": {
        "properties": {
          "status": {
            "enum": [
              "Aberto",
              "Em atendimento",
              "Aguardando",
              "Resolvido",
              "Fechado"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Versão lida (controle otimista; 409 se mudou).",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "StatusIn",
        "type": "object"
      },
      "TicketIn": {
        "properties": {
          "approval": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pedir aprovação na Inbox dos aprovadores.",
            "title": "Approval"
          },
          "category": {
            "enum": [
              "Tecnologia",
              "Software",
              "Acessos",
              "Financeiro",
              "Facilities",
              "Pessoas",
              "Compras",
              "Infraestrutura"
            ],
            "title": "Category",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "priority": {
            "enum": [
              "Baixa",
              "Normal",
              "Alta",
              "Crítica"
            ],
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "category",
          "priority"
        ],
        "title": "TicketIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Token de API do hub (escopo do app), pelo gateway",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "in": "cookie",
        "name": "hub_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Central de Serviços — API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {

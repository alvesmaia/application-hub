{
 "$comment": "Identidade Alvesmaia: papéis de cor (claro/escuro) e a qual papel cada primitiva --c-* do mockup aponta. Fonte única do tema — rode node scripts/gen-dark-theme.mjs depois de mudar.",
 "roles": {
  "page": {
   "light": "#F4F6FB",
   "dark": "#191919",
   "use": "fundo da página"
  },
  "surface": {
   "light": "#FFFFFF",
   "dark": "#202020",
   "use": "superfície de cartões, tabelas, campos"
  },
  "raised": {
   "light": "#FFFFFF",
   "dark": "#272727",
   "use": "superfície elevada (popover, menu, modal)"
  },
  "alt": {
   "light": "#F6F8FD",
   "dark": "#1E1E1E",
   "use": "fundo alternativo (rodapé de lista, zebra)"
  },
  "hover": {
   "light": "#F0F3F8",
   "dark": "#252525",
   "use": "linha em foco/hover, divisória de linha"
  },
  "border": {
   "light": "#E1E6F0",
   "dark": "#2F2F2F",
   "use": "borda de cartão e separadores"
  },
  "border-strong": {
   "light": "#C9D2E3",
   "dark": "#3D3D3D",
   "use": "borda forte decorativa, polegar da barra de rolagem"
  },
  "control": {
   "light": "#7B8799",
   "dark": "#808080",
   "use": "borda de campo de formulário (3:1)"
  },
  "tint": {
   "light": "#EEF1FF",
   "dark": "#232733",
   "use": "chip/realce suave da cor primária"
  },
  "tint-border": {
   "light": "#C5D0FF",
   "dark": "#3A4266",
   "use": "borda de botão secundário e chips"
  },
  "title": {
   "light": "#102A43",
   "dark": "#FFFFFF",
   "use": "títulos"
  },
  "body": {
   "light": "#334E68",
   "dark": "#EDEDED",
   "use": "texto corrido"
  },
  "secondary": {
   "light": "#52606D",
   "dark": "#A5A5A5",
   "use": "texto secundário e rótulos"
  },
  "faint": {
   "light": "#5F6B7A",
   "dark": "#9A9A9A",
   "use": "texto discreto (ainda AA)"
  },
  "ink": {
   "light": "#0F1E2B",
   "dark": "#FFFFFF",
   "use": "quase preto (valores fortes)"
  },
  "primary": {
   "light": "#3A4FD8",
   "dark": "#8FA3FF",
   "use": "botão primário, links, texto de destaque"
  },
  "primary-hover": {
   "light": "#2E3FB8",
   "dark": "#AEBCFF",
   "use": "hover/ativo do primário"
  },
  "on-primary": {
   "light": "#FFFFFF",
   "dark": "#08122E",
   "use": "texto sobre o primário"
  },
  "fill": {
   "light": "#3A4FD8",
   "dark": "#4A64F5",
   "use": "preenchimento índigo com texto branco nos dois temas (botões e barras dos apps)"
  },
  "accent": {
   "light": "#4F6BFF",
   "dark": "#4F6BFF",
   "use": "formas, gráficos e foco (nunca texto corrido)"
  },
  "accent-soft": {
   "light": "#8FA3FF",
   "dark": "#6F86FF",
   "use": "série secundária de gráficos, barras"
  },
  "white": {
   "light": "#FFFFFF",
   "dark": "#FFFFFF",
   "use": "branco fixo (texto sobre cromo e preenchimentos)"
  },
  "ok": {
   "light": "#0B6B3A",
   "dark": "#4FC79A",
   "use": "texto de sucesso"
  },
  "ok-bg": {
   "light": "#DDF5E8",
   "dark": "#1A2E25",
   "use": "fundo de sucesso"
  },
  "ok-border": {
   "light": "#A8DDBF",
   "dark": "#2D5A45",
   "use": "borda de sucesso"
  },
  "ok-shape": {
   "light": "#1F9D5A",
   "dark": "#4FC79A",
   "use": "forma de sucesso (ponto, barra)"
  },
  "warn": {
   "light": "#8A4B00",
   "dark": "#E0A661",
   "use": "texto de aviso"
  },
  "warn-bg": {
   "light": "#FFF1D6",
   "dark": "#2E2517",
   "use": "fundo de aviso"
  },
  "warn-border": {
   "light": "#F0D59A",
   "dark": "#5A4626",
   "use": "borda de aviso"
  },
  "warn-shape": {
   "light": "#E0A100",
   "dark": "#E0A661",
   "use": "forma de aviso"
  },
  "err": {
   "light": "#9B1C1C",
   "dark": "#F08B7C",
   "use": "texto de erro"
  },
  "err-bg": {
   "light": "#FDECEC",
   "dark": "#33201E",
   "use": "fundo de erro"
  },
  "err-border": {
   "light": "#F3C6C6",
   "dark": "#5E302A",
   "use": "borda de erro"
  },
  "err-shape": {
   "light": "#D64545",
   "dark": "#F08B7C",
   "use": "forma de erro"
  },
  "err-fill": {
   "light": "#B42318",
   "dark": "#B42318",
   "use": "preenchimento de erro com texto branco (contador)"
  },
  "neutral-bg": {
   "light": "#EEF0F4",
   "dark": "#272727",
   "use": "fundo de status neutro"
  },
  "chrome": {
   "light": "#102A43",
   "dark": "#1E1E1E",
   "use": "header e rail da plataforma"
  },
  "chrome-raised": {
   "light": "#17365A",
   "dark": "#272727",
   "use": "tooltip/toast sobre o cromo"
  },
  "chrome-text": {
   "light": "#FFFFFF",
   "dark": "#FFFFFF",
   "use": "texto sobre o cromo"
  },
  "chrome-text-2": {
   "light": "#B8C4D6",
   "dark": "#A5A5A5",
   "use": "texto secundário sobre o cromo"
  },
  "chrome-icon": {
   "light": "#C5D0FF",
   "dark": "#C5D0FF",
   "use": "ícones sobre o cromo"
  },
  "scrim": {
   "light": "#102A43",
   "dark": "#000000",
   "use": "base de sombras e véus (usada com transparência)"
  }

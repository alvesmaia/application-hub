[
  {
    "manifest": {
      "id": "inventory",
      "name": "Gestão de Ativos",
      "version": "2.5.0",
      "mode": "fragment",
      "routes": [
        "/inventory/*"
      ],
      "resources": {
        "cpu": 1,
        "memory": "1Gi",
        "pids": 100
      },
      "limits": {
        "max_upload_mb": 50
      },
      "env": [
        "API_BASE_URL"
      ],
      "permissions": [
        "inventory.read"
      ],
      "jobs": [
        {
          "name": "inventory.import",
          "max_duration_s": 3600,
          "max_attempts": 5
        },
        {
          "name": "inventory.export_xlsx",
          "max_duration_s": 1800,
          "max_attempts": 3
        }
      ],
      "sdk": "1.0",
      "runtime": {
        "stack": "python"
      },
      "stack": {
        "language": "Python 3.12",
        "framework": "FastAPI",
        "sdk": "hub-sdk-python 1.0",
        "db": "PostgreSQL 16",
        "libs": [
          "python-calamine",
          "openpyxl",
          "asyncpg"
        ]
      }
    },
    "upstream": "http://hub-app-inventory:8080",
    "display": {
      "description": "Controle e acompanhe os ativos da organização.",
      "color": "#e0f2f1",
      "ink": "#0f766e",
      "icon": "box",
      "short": "Ativos"
    }
  },
  {
    "manifest": {
      "id": "suppliers",
      "name": "Rede de Fornecedores",
      "version": "1.9.0",
      "mode": "fragment",
      "routes": [
        "/suppliers/*"
      ],
      "limits": {
        "max_upload_mb": 25
      },
      "env": [
        "API_BASE_URL"
      ],
      "permissions": [
        "suppliers.read"
      ],
      "sdk": "1.0",
      "runtime": {
        "stack": "python"
      },
      "stack": {
        "language": "Python 3.12",
        "framework": "FastAPI",
        "sdk": "hub-sdk-python 1.0",
        "db": "MinIO (S3)",
        "libs": [
          "asyncpg"
        ]
      }
    },
    "upstream": "http://hub-app-suppliers:8080",
    "display": {
      "description": "Gerencie parceiros, avaliações e contratos em um só lugar.",
      "color": "#f6e4dc",
      "ink": "#9a4530",
      "icon": "groups",
      "short": "Fornecedores"
    }
  },
  {
    "manifest": {
      "id": "servicedesk",
      "name": "Central de Serviços",
      "version": "3.2.0",
      "mode": "fragment",
      "routes": [
        "/servicedesk/*"
      ],
      "notify_roles": [
        "Administrador"
      ],
      "resources": {
        "cpu": 1,
        "memory": "1Gi",
        "pids": 100
      },
      "env": [
        "API_BASE_URL"
      ],
      "permissions": [
        "servicedesk.read"
      ],
      "sdk": "1.0",
      "runtime": {
        "stack": "python"
      },
      "stack": {
        "language": "Python 3.12",
        "framework": "FastAPI",
        "sdk": "hub-sdk-python 1.0",
        "db": "PostgreSQL 16",
        "libs": [
          "asyncpg"
        ]
      }
    },
    "upstream": "http://hub-app-servicedesk:8080",
    "display": {
      "description": "Atendimento interno, solicitações e aprovações em um só lugar.",
      "color": "#e3f1df",
      "ink": "#2d6a3e",
      "icon": "clipboard",
      "short": "Serviços"
    }
  }
]

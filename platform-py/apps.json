    },
    "upstream": "http://app-hub-app-automations:8080",
    "display": {
      "description": "Pacotes de automação em Python, processos, gatilhos agendados e execuções.",
      "color": "#e6e9f7",
      "ink": "#3b4a9e",
      "icon": "play",
      "short": "Automações"
    }
  }

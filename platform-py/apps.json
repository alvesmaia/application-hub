[
  {
    "manifest": {
      "id": "inventory",
      "name": "Gestão de Ativos",
      "version": "2.5.0",
      "mode": "fragment",
      "routes": [
        "/inventory/*"
      ],
      "resources": {
        "cpu": 0.5,
        "memory": "1Gi",
        "pids": 100
      },
      "limits": {
        "max_upload_mb": 50
      },
      "env": [
        "API_BASE_URL"
      ],
      "permissions": [
        "inventory.read"
      ],
      "jobs": [
        {
          "name": "inventory.import",
          "max_duration_s": 3600,
          "max_attempts": 5
        },
        {
          "name": "inventory.export_xlsx",
          "max_duration_s": 1800,
          "max_attempts": 3
        }
      ],
      "sdk": "1.0",
      "runtime": {
        "stack": "python"
      },
      "stack": {
        "language": "Python 3.12",
        "framework": "FastAPI",
        "sdk": "hub-sdk-python 1.0",
        "db": "PostgreSQL 16",
        "libs": [
          "python-calamine",
          "openpyxl",
          "asyncpg"
        ]
      },
      "search": "assets?q="
    },
    "upstream": "http://app-hub-app-inventory:8080",
    "display": {
      "description": "Controle e acompanhe os ativos da organização.",
      "color": "#e0f2f1",
      "ink": "#0f766e",
      "icon": "box",
      "short": "Ativos"
    }
  },
  {
    "manifest": {
      "id": "suppliers",

      ],
      "limits": {
        "max_upload_mb": 25
      },
      "env": [
        "API_BASE_URL"
      ],
      "permissions": [
        "fornecedores.read"
      ],
      "sdk": "1.0",
      "runtime": {
        "stack": "python"
      },
      "stack": {
        "language": "Python 3.12",
        "framework": "FastAPI",
        "sdk": "hub-sdk-python 1.0",
        "db": "MinIO (S3)",
        "libs": [
          "asyncpg"
        ]
      }
    },
    "upstream": "http://app-hub-app-fornecedores:8080",
    "display": {
      "description": "Gerencie parceiros, avaliações e contratos em um só lugar.",
      "color": "#f6e4dc",
      "ink": "#9a4530",
      "icon": "groups",
      "short": "Fornecedores"
    }
  },
  {
    "manifest": {
      "id": "servicos",

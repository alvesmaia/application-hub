    },
    "upstream": "http://app-hub-app-suppliers:8080",
    "display": {
      "description": "Gerencie parceiros, avaliações e contratos em um só lugar.",
      "color": "#f6e4dc",
      "ink": "#9a4530",
      "icon": "groups",
      "short": "Fornecedores"
    }
  },
  {

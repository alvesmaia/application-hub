# Hub edge (app-hub-edge): sole owner of HUB_PORT. Forwards to the hub (`app-hub-web`) and, during an
# zero-downtime update (scripts/hub-update.sh), also to `app-hub-web-next`: only the instance that answers /healthz
# receives traffic, and a refused connection is retried on the other copy (no request is lost in the switch).
{
	admin off
	auto_https disable_redirects # HTTPS only with install.sh --tls-cert (tls.caddy); no port 80
	log {
		level WARN # the app-hub-web-next probe (absent outside updates) does not pollute the log
	}
	servers {
		# cloudflared/proxies in front arrive from a private IP: their X-Forwarded-* headers reach the hub
		trusted_proxies static private_ranges
	}
}

:8090 {
	# plain.caddy (http) or tls.caddy (install.sh --tls-cert: the company certificate in /certs)
	import {$HUB_EDGE_TLS:plain.caddy}
	reverse_proxy app-hub-web:8090 app-hub-web-next:8090 {
		lb_policy first
		lb_try_duration 20s
		lb_try_interval 250ms
		health_uri /healthz
		health_interval 1s
		health_timeout 2s
		flush_interval -1
	}
}
